---
import { Image } from "astro:assets";

import brandHead from "../assets/images/guga-brand-head.png";
import { SITE } from "../config";
import { url } from "../utils/url";
import Icon from "./Icon.astro";
---

<footer class="site-footer closing" id="contact" aria-labelledby="closeTitle">
  <div class="wrap footer__inner">
    <div class="footer__main">
    <div class="footer__close">
      <p class="eyebrow">
        <Icon name="snowflake" size={16} />
        咕嘎永远
      </p>
      <h2 id="closeTitle">想Ta们的时候，<br />就来坐一会儿。</h2>
      <p class="footer__close-line">3 只咕嘎的档案都在这里，随时可以回来看看。</p>
      <a class="btn btn--primary" href={url("/#archive")}>
        翻翻毕业档案
        <Icon name="arrow-down" size={18} />
      </a>
    </div>

    <div class="footer__wordmark" aria-hidden="true">咕嘎永远</div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand" href={url("/")} aria-label={`${SITE.name}首页`}>
          <span class="brand__mark" aria-hidden="true">
            <Image
              src={brandHead}
              alt=""
              width={96}
              height={96}
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="brand__text">
            <span class="brand__cn">{SITE.name}</span>
            <span class="brand__en">{SITE.nameEn}</span>
          </span>
        </a>
        <p class="footer__line">把Ta们留在互联网的一个角落。</p>
      </div>

      <div class="footer__col">
        <h3>档案</h3>
        <ul>
          <li><a href={url("/#archive")}>毕业档案</a></li>
          <li><a href={url("/#about")}>关于这里</a></li>
          <li><a href={SITE.contributingUrl} target="_blank" rel="noopener noreferrer">参与补档</a></li>
        </ul>
      </div>

      <div class="footer__meta">
        <h3>关于</h3>
        <p>非官方粉丝档案。资料与影像来自 B站公开内容，版权归原 UP 主所有。</p>
        <a
          class="footer__github"
          href={SITE.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub 仓库 <Icon name="brand-github" size={16} />
        </a>
        <a class="footer__top" href="#top">
          回到顶部 <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>
    </div>

    <div class="footer__legal">
      <span>© 2026 咕嘎永远</span>
      <span>非官方粉丝档案</span>
      <span>图源：B站，版权归原 UP 主</span>
    </div>
  </div>
</footer>
