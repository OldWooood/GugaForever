---
import { Image } from "astro:assets";

import milkDetail from "../assets/images/milk-1800.webp";
import staysafeDetail from "../assets/images/staysafe-detail-1800.webp";
import { gugas } from "../data/guga";
import { url } from "../utils/url";
import Icon from "./Icon.astro";

const staysafe = gugas.find((guga) => guga.id === "staysafe")!;
const milk = gugas.find((guga) => guga.id === "milk")!;
---

<section class="hero" data-enter aria-labelledby="heroTitle">
  <div class="wrap">
    <div class="hero-text hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">
        <Icon name="snowflake" size={16} />
        B站 · 非官方粉丝档案
      </p>
      <h1 id="heroTitle">B站停更咕嘎<br /><span class="mark">纪念档案</span></h1>
      <p class="hero__sub">Ta们从首页毕业了。B站上已经停更的咕嘎，和Ta们留下的最后样子。</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#archive">
          翻翻毕业档案
          <Icon name="arrow-down" size={18} />
        </a>
      </div>

      <div class="hero__index" aria-label="档案索引">
        <p class="hero__index-label">档案索引</p>
        <ol>
          {gugas.map((guga, index) => (
            <li>
              <a href={url(`/guga/${guga.id}/`)}>
                <span class="hero__index-no">{String(index + 1).padStart(2, "0")}</span>
                <span class="hero__index-name">{guga.name}</span>
                <time datetime={guga.date}>{guga.dateLabel}</time>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <figure class="photo photo--pair" aria-label="两只咕嘎的纪念照片">
      <span class="tape" aria-hidden="true"></span>
      <div class="photo__pair">
        <Image
          src={staysafeDetail}
          alt={staysafe.detailAlt ?? staysafe.imageAlt}
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 980px) 90vw, 43vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <Image
          src={milkDetail}
          alt={milk.detailAlt ?? milk.imageAlt}
          widths={[360, 540, 720]}
          sizes="(max-width: 980px) 90vw, 43vw"
          loading="eager"
          decoding="async"
        />
      </div>
    </figure>

    <div class="hero__facts">
      <div><span>收录</span><strong>3 只咕嘎</strong></div>
      <div><span>停更</span><strong>2026.09–10</strong></div>
      <div><span>最近毕业</span><strong>2026.10.23</strong></div>
    </div>
    </div>
  </div>
</section>
