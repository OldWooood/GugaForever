---
import { Image } from "astro:assets";

import brandHead from "../assets/images/guga-brand-head.png";
import { SITE } from "../config";
import { url } from "../utils/url";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header nav">
  <a class="skip-link" href="#top">跳到主要内容 Skip to content</a>
  <div class="wrap nav__inner">
    <a class="brand" href={url("/")} aria-label={`${SITE.name}首页`}>
      <span class="brand__mark" aria-hidden="true">
        <Image
          src={brandHead}
          alt=""
          width={96}
          height={96}
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="brand__text">
        <span class="brand__cn">{SITE.name}</span>
        <span class="brand__en">{SITE.nameEn}</span>
      </span>
    </a>

    <div class="nav__actions">
      <nav class="nav__links" id="primaryNav" aria-label="主导航">
        <a class="nav__link" href={url("/#archive")}>毕业档案</a>
        <a class="nav__link" href={url("/#about")}>关于这里</a>
        <a class="btn btn--primary nav__cta" href={url("/#archive")}>翻翻毕业档案</a>
      </nav>

      <ThemeToggle />

      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primaryNav"
        aria-label="打开菜单"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
