---
import { Image } from "astro:assets";

import brandHead from "../assets/images/guga-brand-head.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url";
---

<BaseLayout
  title="404：这只咕嘎走丢了｜咕嘎永远"
  description="页面可能搬走了，也可能从来没有在这里住过。"
  noindex
  path="/404.html"
>
  <main id="top">
    <section class="not-found" aria-labelledby="errorTitle">
      <div class="wrap">
        <div class="hero-text not-found__grid">
        <div class="not-found__copy">
          <h1 id="errorTitle">404 · 这只咕嘎走丢了</h1>
          <p>页面可能搬走了，也可能从来没有在这里住过。先回毕业档案看看吧。</p>
          <a class="btn btn--primary" href={url("/#archive")}>回到毕业档案</a>
        </div>

        <figure class="not-found__visual">
          <Image
            src={brandHead}
            alt="咕嘎永远的档案标志"
            widths={[256, 384, 512]}
            sizes="(max-width: 720px) 100vw, 40vw"
            loading="eager"
            decoding="async"
          />
        </figure>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
